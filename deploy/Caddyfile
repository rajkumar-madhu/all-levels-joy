# APP_DOMAIN serves the React app and the API; AUTH_DOMAIN serves Keycloak. Caddy gets and renews
# certificates automatically (ports 80 and 443 must reach this host).
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://{$AUTH_DOMAIN}; frame-src https://{$AUTH_DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://{$AUTH_DOMAIN}"
		-Server
	}

	# Webhooks and the API; the API sets its own cache headers (reveals are no-store).
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}

	# Hashed build assets can be cached forever; the app shell (index.html for every route) never.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@shell not path /assets/* /api/* /health
	header @shell Cache-Control "no-cache"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

{$AUTH_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# The Keycloak admin console is only reachable from KEYCLOAK_ADMIN_CIDRS (default: nowhere public;
	# use an SSH tunnel to 127.0.0.1:8081 on the host instead).
	@admin {
		path /admin /admin/*
		not remote_ip {$KEYCLOAK_ADMIN_CIDRS}
	}
	respond @admin 404

	reverse_proxy keycloak:8080
}
