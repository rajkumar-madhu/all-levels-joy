# Copy to deploy/.env and fill in. Generate secrets with: openssl rand -base64 32
# Keep this file out of git (deploy/.env is ignored).

# Public names; both need DNS A/AAAA records pointing at this host, and ports 80/443 open.
APP_DOMAIN=itsm.example.com
AUTH_DOMAIN=sso.example.com
ACME_EMAIL=ops@example.com

# Database passwords (used only on the internal network)
POSTGRES_SUPERUSER_PASSWORD=
ITSM_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# Keycloak bootstrap administrator (admin console via SSH tunnel; see README)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# Space-separated networks allowed to open https://AUTH_DOMAIN/admin directly (default: none)
KEYCLOAK_ADMIN_CIDRS=127.0.0.1/32

# Django
DJANGO_SECRET_KEY=

# Privileged access vault: 32-byte key, base64. Back it up separately from database backups;
# without it the vaulted passwords cannot be decrypted.
PAM_MASTER_KEY=
PAM_ROTATION_BACKEND=live
# Files under deploy/pam/ are mounted at /run/pam (read-only), e.g. PAM_SSH_KNOWN_HOSTS=/run/pam/known_hosts
PAM_SSH_KNOWN_HOSTS=
PAM_DB_SSLMODE=require
PAM_DB_SSL_CA=
PAM_WINRM_CA=

# Webhooks and notifications (optional)
MONITORING_WEBHOOK_TOKEN=
PAGERDUTY_WEBHOOK_SECRET=
SECURITY_SCANNER_SECRET=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
INTEGRATION_ORG_ID=10000000-0000-0000-0000-000000000001
PORTAL_ORG_ID=10000000-0000-0000-0000-000000000001
PORTAL_EMAIL_DOMAIN=wecrew.in

# Notification emails (SMTP). Leave EMAIL_HOST empty to send none; the in-app bell works either way.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Argus Service Desk <no-reply@example.com>

# Support assistant (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Evidence attachments: "filesystem" (Docker volume) or "s3"
EVIDENCE_STORAGE=filesystem
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_ENDPOINT_URL=
EVIDENCE_S3_REGION=
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
