# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL 16 (the login role needs membership in anon, authenticated and service_role)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=itsm
POSTGRES_USER=itsm_api
POSTGRES_PASSWORD=change-me

# Keycloak realm and the audience the SPA's tokens carry
KEYCLOAK_ISSUER=http://localhost:8080/realms/itsm
KEYCLOAK_AUDIENCE=itsm-api

# OPA sidecar
OPA_URL=http://localhost:8181

# Redis 7 (Celery broker)
REDIS_URL=redis://localhost:6379/0

# Public intake secrets (same names as the legacy app)
MONITORING_WEBHOOK_TOKEN=
PAGERDUTY_WEBHOOK_SECRET=
SECURITY_SCANNER_SECRET=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
INTEGRATION_ORG_ID=10000000-0000-0000-0000-000000000001
APP_PUBLIC_URL=http://localhost:5173

# Support assistant (Anthropic API). Leave the key empty to show "not configured".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ASSISTANT_MAX_TOKENS=16000

# Customer portal: confirmed accounts on this domain may use /portal; tickets file into this workspace
PORTAL_EMAIL_DOMAIN=wecrew.in
PORTAL_ORG_ID=10000000-0000-0000-0000-000000000001

# Privileged access vault: base64 AES-256 key (openssl rand -base64 32), required unless DJANGO_DEBUG=1.
# Rotation backend "ssh" (hosts must be in the known_hosts file) or "simulated" (vault copy only, development).
PAM_MASTER_KEY=
PAM_ROTATION_BACKEND=simulated
PAM_SSH_KNOWN_HOSTS=
PAM_SSH_TIMEOUT_SECONDS=10

# Repository root holding supabase/ and drizzle/ (for apply_legacy_schema)
LEGACY_SQL_ROOT=..

# Evidence attachments: "filesystem" (default, EVIDENCE_ROOT) or "s3" (any S3-compatible store, private bucket)
EVIDENCE_STORAGE=filesystem
EVIDENCE_ROOT=
EVIDENCE_S3_BUCKET=itsm-evidence
EVIDENCE_S3_ENDPOINT_URL=
EVIDENCE_S3_REGION=
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
